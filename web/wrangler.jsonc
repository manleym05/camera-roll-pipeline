{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Review page: static React build + a Worker that proxies /api through a Cloudflare Tunnel
  // (Workers VPC, no public API hostname) and serves thumbnails from private R2.
  // Cloudflare Access protects the workers.dev URL; the Worker and the API both re-check its JWT.
  "name": "photo-review",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/thumbs/*"]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "your-media-bucket" }],
  "vpc_services": [{ "binding": "API", "service_id": "YOUR_VPC_SERVICE_ID" }],
  "vars": {
    // From the Worker's Access tab (Worker policy: "Allow the owner", all traffic). Not secrets.
    "ACCESS_TEAM_DOMAIN": "YOUR-TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "YOUR_ACCESS_AUD_TAG"
  },
  "observability": { "enabled": true }
}
