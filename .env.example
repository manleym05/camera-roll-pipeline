# --- shared ---
# Token the PC agent sends to the API (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
AGENT_TOKEN=change-me

# --- api ---
DATABASE_URL=postgresql+psycopg://brand:brand@localhost:5433/brand
# Media within HOME_RADIUS_M of a home is never postable; HOME_TRIP_KM separates trips from local events
# Homes over time (JSON). Each is geofenced; trips are measured from the home lived in at the time.
# start inclusive, end exclusive, either may be omitted.
HOMES=[{"lat":0.0,"lon":0.0,"end":"2026-03-15","label":"Old home"},{"lat":0.0,"lon":0.0,"start":"2026-03-15","label":"Home"}]
# Content pillars: the categories a photo can serve. Rename, drop or add freely.
# The scorer is given these exact values and anything else is rejected on import.
# If you change them, change PILLAR_PROMPTS in agent/brand_agent/config.py to match.
PILLARS=["work","tech","fitness","travel"]
# Optional shortlisting bias. Empty means every pillar counts the same.
# PILLAR_WEIGHTS={"work":0.35,"tech":0.25,"fitness":0.2,"travel":0.2}
HOME_RADIUS_M=300
HOME_TRIP_KM=100

# --- agent ---
API_URL=http://127.0.0.1:8000
PHOTOS_DIR=C:\Users\you\Pictures\iCloud Photos\Photos
INGEST_SINCE=2024-01-01
# Other camera rolls, ingested with: brand-agent scan --owner <name>
OWNER_DIRS={"partner":"C:/Users/you/Pictures/Partner"}
# storage backend for thumbnails: local | r2
STORAGE=local
# LOCAL_STORAGE_DIR defaults to <repo>/data/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=brand-media
# cuda | cpu | auto
CLIP_DEVICE=auto

# --- review page ---
# access = require a Cloudflare Access JWT for REVIEWER_EMAILS; none = open (local dev only)
REVIEW_AUTH=access
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
REVIEWER_EMAILS=["you@example.com"]
# "" serves thumbnails from the API at /thumbs; or an R2 public URL
THUMB_BASE_URL=
CORS_ORIGINS=[]

# Words a caption must never contain on a given platform (JSON lists).
# Useful when an employer, client or project name belongs on one feed but not another.
INSTAGRAM_BLOCKED_TERMS=[]
X_BLOCKED_TERMS=[]
